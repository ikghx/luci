#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:310
msgid "ingress and egress are both 0 — nothing is shaped"
msgstr "出入站均为 0 — 没有流量被整形"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:943
msgid "interface %s"
msgstr "接口 %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1199
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1235
msgid "match"
msgstr "匹配"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:292
msgid ""
"mode \"%s\" is not a CAKE diffserv mode — tc refuses the qdisc, so nothing "
"is shaped although qosify reports the section active"
msgstr ""
"模式“%s”并非 CAKE 的 DiffServ 模式 — tc 拒绝了该排队规则（qdisc），因此实际上"
"并未进行流量整形，尽管 qosify 显示该部分处于激活状态。"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:291
msgid ""
"name \"%s\" is dropped by qosify — it takes at most %d characters and no "
"quote"
msgstr "名称“%s”被 qosify 舍弃 — 该名称最多包含 %d 个字符，且不得包含引号。"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:290
msgid ""
"name is not set — qosify.init sends an empty device name and this section is "
"never applied"
msgstr "名称未设置 — qosify.init 发送空的设备名，此部分从未应用"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:306
msgid ""
"nat is not sent: qosify only emits nat/nonat inside the host_isolate branch. "
"CAKE does accept flows plus nat — put nat in options to apply it"
msgstr ""
"nat 未发送：qosify 只在 host_isolate 分支内发出 nat/nonat。CAKE 不接受流加 "
"nat — 将 nat 放在 options 中来应用它"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:307
msgid ""
"nat only reaches %s — put it in options, or in both ingress_options and "
"egress_options"
msgstr ""
"nat 只达到 %s — 将它放在 options 中，或者放在 ingress_options 和 "
"egress_options 中"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:72
msgid ""
"netifd interface (config interface) or netdev (config device) to enable QoS "
"on"
msgstr "netifd 接口（配置接口）或 netdev（配置设备）用于启用 QoS"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:761
msgid "netifd interface to enable QoS on. Required."
msgstr "需启用 QoS 的 netifd 接口。必填项。"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1313
msgid "never"
msgstr "永不"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:945
msgid "no"
msgstr ""

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:312
msgid "no bandwidth_down or bandwidth — ingress CAKE runs unlimited"
msgstr "没有 bandwidth_down 或 bandwidth — 入站 CAKE 运行不受限"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:311
msgid "no bandwidth_up or bandwidth — egress CAKE runs unlimited"
msgstr "没有 bandwidth_up 或 bandwidth — 出站 CAKE 运行不受限"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:925
msgid "none"
msgstr ""

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:309
msgid "overhead and overhead_encap are ignored unless overhead_type is manual"
msgstr "除非 overhead_type 为手动，否则忽略 overhead 和 overhead_encap"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:299
msgid "overhead_encap \"%s\" is not atm, noatm or ptm — tc refuses the qdisc"
msgstr "overhead_encap “%s” 既不是 atm、noatm，也不是 ptm — tc 拒绝了该 qdisc"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:296
msgid ""
"overhead_type \"%s\" is not one qosify.init knows, so no overhead is set"
msgstr ""
"“overhead_type”参数值“%s”不被 qosify.init 所识别，因此未设置开销 (overhead)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:302
msgid "overhead_vlan \"%s\" is not 0, 1 or 2 — qosify.init adds no ether-vlan"
msgstr ""
"overhead_vlan “%s” 的值不是 0、1 或 2 — qosify.init 不会添加 ether-vlan"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:636
