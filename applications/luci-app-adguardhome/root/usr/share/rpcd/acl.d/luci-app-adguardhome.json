{
	"luci-app-adguardhome": {
		"description": "Grant permissions for the AdGuard Home LuCI app",
		"read": {
			"file": {
				"/etc/adguardhome/adguardhome.yaml": [ "read" ],
				"/etc/init.d/AdGuardHome": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "adguardhome" ]
			},
		"write": {
			"file": {
				"/etc/adguardhome/adguardhome.yaml": [ "write" ]
			},
			"uci": [ "adguardhome" ]
		}
	}
}
