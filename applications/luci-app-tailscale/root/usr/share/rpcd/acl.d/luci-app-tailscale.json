{
	"luci-app-tailscale": {
		"description": "Grant access to Tailscale configuration",
		"read": {
			"file": {
				"/sbin/ip -s -j ad": [ "exec" ],
				"/sbin/logread -e tailscale": [ "exec" ],
				"/usr/sbin/tailscale": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "tailscale" ]
		},
		"write": {
			"uci": [ "tailscale" ]
		}
	}
}
