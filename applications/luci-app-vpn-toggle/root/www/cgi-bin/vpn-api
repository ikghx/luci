#!/bin/sh
# /www/cgi-bin/vpn-api

echo "Content-Type: application/json"
echo "Cache-Control: no-cache"
echo ""

# Block access from non-local IP addresses
case "$REMOTE_ADDR" in
    10.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*|192.168.*|127.*) ;;
    *) echo '{"error":"Access denied"}'; exit 0 ;;
esac

# Read POST body only (credentials must not travel in the URL)
case "$CONTENT_LENGTH" in
    ''|*[!0-9]*) LEN=0 ;;
    *) LEN=$CONTENT_LENGTH; [ "$LEN" -gt 2048 ] && LEN=2048 ;;
esac
BODY=''
[ "$LEN" -gt 0 ] && BODY=$(dd bs=1 count="$LEN" 2>/dev/null)

# URL-decode a single field value (handles %XX and + → space)
urldecode() {
    printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%\([0-9a-fA-F][0-9a-fA-F]\)/\\x\1/g')"
}

REQ_USER=$(urldecode "$(printf '%s' "$BODY" | grep -o 'user=[^&]*' | cut -d= -f2-)")
REQ_PASS=$(urldecode "$(printf '%s' "$BODY" | grep -o 'pass=[^&]*' | cut -d= -f2-)")
ACTION=$(printf '%s' "$BODY" | grep -o 'action=[^&]*' | cut -d= -f2-)
SWITCH_ID=$(printf '%s' "$BODY" | grep -o 'switch=[^&]*' | cut -d= -f2-)

# Per-IP brute-force protection: 5 failures triggers a 5-minute lockout
LOCK_FILE="/tmp/vpntoggle_lk_$(printf '%s' "$REMOTE_ADDR" | tr -cd '[:alnum:]_')"
LOCKOUT_MAX=5
LOCKOUT_SECS=300
if [ -f "$LOCK_FILE" ]; then
    LOCK_COUNT=$(sed -n '1p' "$LOCK_FILE")
    LOCK_TIME=$(sed -n '2p' "$LOCK_FILE")
    NOW=$(date +%s)
    if [ "${LOCK_COUNT:-0}" -ge "$LOCKOUT_MAX" ] && \
       [ $(( NOW - ${LOCK_TIME:-0} )) -lt "$LOCKOUT_SECS" ]; then
        echo '{"error":"Too many failed attempts. Try again later."}'
        exit 0
    fi
    [ $(( NOW - ${LOCK_TIME:-0} )) -ge "$LOCKOUT_SECS" ] && rm -f "$LOCK_FILE"
fi

# JSON-escape a string value
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'; }

# Authenticate: loop through all user sections
AUTH=0
AUTH_USER=''
i=0
while true; do
    CFG_USER=$(uci -q get "vpn_toggle.@user[$i].username" 2>/dev/null)
    [ -z "$CFG_USER" ] && break
    CFG_PASS=$(uci -q get "vpn_toggle.@user[$i].password" 2>/dev/null)
    if [ "$REQ_USER" = "$CFG_USER" ] && [ "$REQ_PASS" = "$CFG_PASS" ]; then
        AUTH=1
        AUTH_USER="$CFG_USER"
        break
    fi
    i=$((i + 1))
done

if [ "$AUTH" = "0" ]; then
    NOW=$(date +%s)
    COUNT=1
    [ -f "$LOCK_FILE" ] && COUNT=$(( $(sed -n '1p' "$LOCK_FILE") + 1 ))
    printf '%s\n%s\n' "$COUNT" "$NOW" > "$LOCK_FILE"
    echo '{"error":"Unauthorized"}'
    exit 0
fi

# Successful auth — clear any lockout for this IP
rm -f "$LOCK_FILE"

# list: return all switches with current routing state
if [ "$ACTION" = "list" ]; then
    OUT='['
    SEP=''
    i=0
    while true; do
        DNAME=$(uci -q get "vpn_toggle.@switch[$i].display_name" 2>/dev/null)
        [ -z "$DNAME" ] && break
        SW_USER=$(uci -q get "vpn_toggle.@switch[$i].user" 2>/dev/null)
        if [ -z "$SW_USER" ] || [ "$SW_USER" = "$AUTH_USER" ]; then
            RULE=$(uci -q get "vpn_toggle.@switch[$i].pbr_rule")
            WAN_IF=$(uci -q get "vpn_toggle.@switch[$i].wan_if")
            VPN_IF=$(uci -q get "vpn_toggle.@switch[$i].vpn_if")
            CURRENT_IF=$(uci -q get "pbr.$RULE.interface")
            OUT="${OUT}${SEP}{\"id\":${i},\"name\":\"$(json_esc "$DNAME")\",\"rule\":\"$(json_esc "$RULE")\",\"current_if\":\"$(json_esc "$CURRENT_IF")\",\"wan_if\":\"$(json_esc "$WAN_IF")\",\"vpn_if\":\"$(json_esc "$VPN_IF")\"}"
            SEP=','
        fi
        i=$((i + 1))
    done
    echo "${OUT}]"
    exit 0
fi

# toggle: flip one switch by index
if [ "$ACTION" = "toggle" ] && [ -n "$SWITCH_ID" ]; then
    # Validate SWITCH_ID is a non-negative integer
    case "$SWITCH_ID" in
        ''|*[!0-9]*) echo '{"error":"Invalid switch id"}'; exit 0 ;;
    esac
    SW_USER=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].user" 2>/dev/null)
    if [ -n "$SW_USER" ] && [ "$SW_USER" != "$AUTH_USER" ]; then
        echo '{"error":"Forbidden"}'
        exit 0
    fi
    RULE=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].pbr_rule")
    WAN_IF=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].wan_if")
    VPN_IF=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].vpn_if")
    TARGET_DEVICE=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].target_device")
    TARGET_SUBNET=$(uci -q get "vpn_toggle.@switch[$SWITCH_ID].target_subnet")

    if [ -z "$RULE" ]; then
        echo '{"error":"Invalid switch"}'
        exit 0
    fi

    CURRENT_IF=$(uci -q get "pbr.$RULE.interface")
    if [ "$CURRENT_IF" = "$WAN_IF" ]; then
        NEXT_IF=$VPN_IF
    else
        NEXT_IF=$WAN_IF
    fi

    ACTIVE_SRC="$TARGET_SUBNET"
    [ -n "$TARGET_DEVICE" ] && ACTIVE_SRC="$TARGET_DEVICE"

    OLD_SRC=$(uci -q get "pbr.$RULE.src_addr")
    uci set "pbr.$RULE.interface=$NEXT_IF"
    [ -n "$ACTIVE_SRC" ] && uci set "pbr.$RULE.src_addr=$ACTIVE_SRC"

    DNS_RULE=$(uci show pbr | grep "src_addr='$OLD_SRC'" | grep "dns_policy" | cut -d. -f2 | head -n 1)
    if [ -n "$DNS_RULE" ]; then
        if [ "$NEXT_IF" = "$VPN_IF" ]; then
            uci set "pbr.$DNS_RULE.enabled=1"
        else
            uci set "pbr.$DNS_RULE.enabled=0"
        fi
    fi

    uci commit pbr
    /etc/init.d/pbr reload > /dev/null 2>&1
    echo "{\"success\":true,\"new_if\":\"$NEXT_IF\"}"
    exit 0
fi

echo '{"error":"Invalid action"}'